{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["wxt/client", "wxt/browser", "chrome"]
  },
  "include": ["src", "tests", "wxt.config.ts", "vitest.config.ts", ".wxt/types"]
}
